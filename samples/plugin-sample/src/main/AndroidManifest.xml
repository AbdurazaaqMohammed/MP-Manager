<?xml version="1.0" encoding="utf-8"?>
<!-- Sample external plugin for MP-Manager. Copy this module as a starter:
     own applicationId/UID/permissions, one exported activity per area. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The TITLE <meta-data> values below are intentionally literal English,
         not @string references: the host reads them through PackageManager in
         the HOST's configuration, so a resource reference would resolve against
         the host's resource table (and fail) instead of this plugin's. The
         android:label values above do resolve against this app and are localized. -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".SidebarActivity"
            android:exported="true"
            android:label="@string/label_sidebar">
            <intent-filter>
                <action android:name="io.github.abdurazaaqmohammed.MPManager.action.SIDEBAR_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.PLUGIN_ID"
                android:value="sample.sidebar" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.TITLE"
                android:value="Sample Sidebar" />
        </activity>

        <activity
            android:name=".SettingActivity"
            android:exported="true"
            android:label="@string/label_setting">
            <intent-filter>
                <action android:name="io.github.abdurazaaqmohammed.MPManager.action.SETTING_CONFIG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.PLUGIN_ID"
                android:value="sample.demo" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.TITLE"
                android:value="Sample Toggle" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.SETTING_KEY"
                android:value="plugin.sample.demo_enabled" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.SETTING_TYPE"
                android:value="boolean" />
        </activity>

        <activity
            android:name=".FileActionActivity"
            android:exported="true"
            android:label="@string/label_hash">
            <intent-filter>
                <action android:name="io.github.abdurazaaqmohammed.MPManager.action.FILE_MENU" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.PLUGIN_ID"
                android:value="sample.hash" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.TITLE"
                android:value="Sample Hash" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.FILE_MIME"
                android:value="text/*" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.FILE_PATTERN"
                android:value=".*\.txt" />
        </activity>

        <activity
            android:name=".EditorActivity"
            android:exported="true"
            android:label="@string/label_uppercase">
            <intent-filter>
                <action android:name="io.github.abdurazaaqmohammed.MPManager.action.EDITOR_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.PLUGIN_ID"
                android:value="sample.uppercase" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.TITLE"
                android:value="SAMPLE UPPERCASE" />
        </activity>

        <activity
            android:name=".ApkActivity"
            android:exported="true"
            android:label="@string/label_apk">
            <intent-filter>
                <action android:name="io.github.abdurazaaqmohammed.MPManager.action.APK_ACTION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.PLUGIN_ID"
                android:value="sample.apkscan" />
            <meta-data
                android:name="io.github.abdurazaaqmohammed.MPManager.TITLE"
                android:value="Sample APK Scan" />
        </activity>

    </application>

</manifest>
