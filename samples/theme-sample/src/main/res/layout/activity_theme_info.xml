<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E16"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/wallpaper_view"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:contentDescription="@string/wallpaper_desc"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/theme_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/theme_name"
        android:textColor="#FFE6E6F0"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/theme_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/theme_details"
        android:textColor="#B3E6E6F0"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/preview_view"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/preview_desc"
        android:scaleType="centerCrop" />

</LinearLayout>
