<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/edpref_display">
        <DropDownPreference
            android:key="pref_theme"
            android:title="@string/edpref_theme"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:summary="@string/edpref_theme_summary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="font_type"
            android:title="@string/edpref_font_type"
            android:entries="@array/font_styles"
            android:entryValues="@array/font_style_values"
            android:defaultValue="normal"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="pref_font_size"
            android:title="@string/edpref_font_size"
            android:entries="@array/font_sizes"
            android:entryValues="@array/font_size_values"
            android:defaultValue="14"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="pref_show_line_numbers"
            android:title="@string/edpref_show_line_numbers"
            android:summary="@string/edpref_show_line_numbers_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_word_wrap"
            android:title="@string/edpref_word_wrap"
            android:summary="@string/edpref_word_wrap_summary"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_syntax_highlight"
            android:title="@string/edpref_syntax_highlight"
            android:summary="@string/edpref_syntax_highlight_summary"
            android:defaultValue="true"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/edpref_editing">
        <EditTextPreference
            android:key="pref_tab_size"
            android:title="@string/edpref_tab_size"
            android:summary="@string/edpref_tab_size_summary"
            android:defaultValue="4"/>

        <SwitchPreferenceCompat
            android:key="pref_use_spaces"
            android:title="@string/edpref_use_spaces"
            android:summary="@string/edpref_use_spaces_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_auto_indent"
            android:title="@string/edpref_auto_indent"
            android:summary="@string/edpref_auto_indent_summary"
            android:defaultValue="true"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/edpref_advanced">
       <Preference
            android:key="pref_import_syntax"
            android:title="@string/edpref_import_syntax"
            android:summary="@string/edpref_import_syntax_summary"/>

      <Preference
            android:key="pref_bottom_bar_buttons"
            android:title="@string/edpref_bottom_bar"
            android:summary="@string/edpref_bottom_bar_summary"/>

      <Preference
            android:key="edit_floating_menus"
            android:title="@string/edpref_floating_menus"
            android:summary="@string/edpref_floating_menus_summary"/>
    </PreferenceCategory>

    <PreferenceCategory android:key="gemini_ai_category"
                        android:title="@string/edpref_ai_category">
        <EditTextPreference
            android:key="gemini_api_key"
            android:title="@string/edpref_api_key"
            android:summary="@string/edpref_api_key_summary"
            android:dialogTitle="@string/edpref_api_key_dialog"
            android:defaultValue="" />

        <ListPreference
            android:key="gemini_model"
            android:title="@string/edpref_gemini_model"
            android:entries="@array/gemini_model_entries"
            android:entryValues="@array/gemini_model_values"
            android:defaultValue="gemini-3.5-flash-lite"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="gemini_refresh_models"
            android:title="@string/edpref_refresh_models"
            android:summary="@string/edpref_refresh_models_summary" />

        <Preference
            android:key="gemini_disclaimer"
            android:title="@string/edpref_ai_notice"
            android:selectable="false"
            android:summary="@string/edpref_ai_notice_summary" />

        <SwitchPreferenceCompat
            android:key="edit_ai_prompt"
            android:title="@string/edpref_custom_prompt"
            android:summary="@string/edpref_custom_prompt_summary"
            android:defaultValue="false" />

        <Preference
            android:key="gemini_website"
            android:title="@string/edpref_get_api_key"
            android:summary="@string/edpref_get_api_key_summary" />
    </PreferenceCategory>

</PreferenceScreen>
