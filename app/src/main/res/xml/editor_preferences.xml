<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/edpref_display">
        <DropDownPreference
            android:key="pref_theme"
            android:title="@string/edpref_theme"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:summary="@string/edpref_theme_summary"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="font_type"
            android:title="@string/edpref_font_type"
            android:entries="@array/font_styles"
            android:entryValues="@array/font_style_values"
            android:defaultValue="normal"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="pref_font_size"
            android:title="@string/edpref_font_size"
            android:entries="@array/font_sizes"
            android:entryValues="@array/font_size_values"
            android:defaultValue="14"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="pref_line_spacing"
            android:title="@string/edpref_line_spacing"
            android:entries="@array/line_spacing_entries"
            android:entryValues="@array/line_spacing_values"
            android:defaultValue="1.1"
            android:summary="@string/edpref_line_spacing_summary"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="pref_show_line_numbers"
            android:title="@string/edpref_show_line_numbers"
            android:summary="@string/edpref_show_line_numbers_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_pin_line_numbers"
            android:title="@string/edpref_pin_line_numbers"
            android:summary="@string/edpref_pin_line_numbers_summary"
            android:defaultValue="false"
            app:dependency="pref_show_line_numbers"/>

        <SwitchPreferenceCompat
            android:key="pref_word_wrap"
            android:title="@string/edpref_word_wrap"
            android:summary="@string/edpref_word_wrap_summary"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_wrap_without_splitting_words"
            android:title="@string/edpref_wrap_without_splitting_words"
            android:summary="@string/edpref_wrap_without_splitting_words_summary"
            android:defaultValue="true"
            app:dependency="pref_word_wrap"/>

        <SwitchPreferenceCompat
            android:key="pref_syntax_highlight"
            android:title="@string/edpref_syntax_highlight"
            android:summary="@string/edpref_syntax_highlight_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_highlight_current_line"
            android:title="@string/edpref_highlight_current_line"
            android:summary="@string/edpref_highlight_current_line_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_show_indent_guides"
            android:title="@string/edpref_show_indent_guides"
            android:summary="@string/edpref_show_indent_guides_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_show_blank_symbols"
            android:title="@string/edpref_show_blank_symbols"
            android:summary="@string/edpref_show_blank_symbols_summary"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_hide_single_space"
            android:title="@string/edpref_hide_single_space"
            android:summary="@string/edpref_hide_single_space_summary"
            android:defaultValue="true"
            app:dependency="pref_show_blank_symbols"/>

        <SwitchPreferenceCompat
            android:key="pref_show_invisible_characters"
            android:title="@string/edpref_show_invisible_characters"
            android:summary="@string/edpref_show_invisible_characters_summary"
            android:defaultValue="false"/>

        <SwitchPreferenceCompat
            android:key="pref_sticky_scroll"
            android:title="@string/edpref_sticky_scroll"
            android:summary="@string/edpref_sticky_scroll_summary"
            android:defaultValue="true"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/edpref_editing">
        <EditTextPreference
            android:key="pref_tab_size"
            android:title="@string/edpref_tab_size"
            android:summary="@string/edpref_tab_size_summary"
            android:defaultValue="4"/>

        <SwitchPreferenceCompat
            android:key="pref_use_spaces"
            android:title="@string/edpref_use_spaces"
            android:summary="@string/edpref_use_spaces_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_auto_indent"
            android:title="@string/edpref_auto_indent"
            android:summary="@string/edpref_auto_indent_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="pref_auto_pair_brackets"
            android:title="@string/edpref_auto_pair_brackets"
            android:summary="@string/edpref_auto_pair_brackets_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="auto_complete"
            android:title="@string/edpref_auto_complete"
            android:summary="@string/edpref_auto_complete_summary"
            android:defaultValue="true"/>

        <SwitchPreferenceCompat
            android:key="auto_complete_new_line_only"
            android:title="@string/edpref_auto_complete_new_line_only"
            android:summary="@string/edpref_auto_complete_new_line_only_summary"
            android:defaultValue="false"
            app:dependency="auto_complete"/>

        <SwitchPreferenceCompat
            android:key="pref_completion_on_enter"
            android:title="@string/edpref_completion_on_enter"
            android:summary="@string/edpref_completion_on_enter_summary"
            android:defaultValue="true"
            app:dependency="auto_complete"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/edpref_advanced">
       <Preference
            android:key="pref_import_syntax"
            android:title="@string/edpref_import_syntax"
            android:summary="@string/edpref_import_syntax_summary"/>

      <Preference
            android:key="pref_bottom_bar_buttons"
            android:title="@string/edpref_bottom_bar"
            android:summary="@string/edpref_bottom_bar_summary"/>

      <Preference
            android:key="edit_floating_menus"
            android:title="@string/edpref_floating_menus"
            android:summary="@string/edpref_floating_menus_summary"/>
    </PreferenceCategory>

    <PreferenceCategory android:key="gemini_ai_category"
                        android:title="@string/edpref_ai_category">
        <EditTextPreference
            android:key="gemini_api_key"
            android:title="@string/edpref_api_key"
            android:summary="@string/edpref_api_key_summary"
            android:dialogTitle="@string/edpref_api_key_dialog"
            android:defaultValue="" />

        <ListPreference
            android:key="gemini_model"
            android:title="@string/edpref_gemini_model"
            android:entries="@array/gemini_model_entries"
            android:entryValues="@array/gemini_model_values"
            android:defaultValue="gemini-3.5-flash-lite"
            app:useSimpleSummaryProvider="true" />

        <Preference
            android:key="gemini_refresh_models"
            android:title="@string/edpref_refresh_models"
            android:summary="@string/edpref_refresh_models_summary" />

        <Preference
            android:key="gemini_disclaimer"
            android:title="@string/edpref_ai_notice"
            android:selectable="false"
            android:summary="@string/edpref_ai_notice_summary" />

        <SwitchPreferenceCompat
            android:key="edit_ai_prompt"
            android:title="@string/edpref_custom_prompt"
            android:summary="@string/edpref_custom_prompt_summary"
            android:defaultValue="false" />

        <Preference
            android:key="gemini_website"
            android:title="@string/edpref_get_api_key"
            android:summary="@string/edpref_get_api_key_summary" />
    </PreferenceCategory>

</PreferenceScreen>
