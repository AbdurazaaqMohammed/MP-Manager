<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="mp_nav_bar_legacy">#FF1C1B1F</color>

    <style name="Theme.MyApp.Black" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="colorSurface">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorSurfaceVariant">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MPManager.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MPManager.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MPManager.Large</item>
    </style>
    <style name="Theme.MyApp.Dark" parent="Theme.Material3.DynamicColors.Dark.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MPManager.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MPManager.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MPManager.Large</item>
    </style>

    <!-- Base (API < 27): windowLightNavigationBar is ignored there, so a
         surface-colored nav bar would show white icons on white. A dark bar
         keeps the white system icons visible; values-v27 restores the
         surface-colored bar with dark icons. -->
    <style name="Theme.MyApp.System" parent="Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">@color/mp_nav_bar_legacy</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MPManager.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MPManager.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MPManager.Large</item>
    </style>
    <style name="Theme.MyApp.Light" parent="Theme.Material3.DynamicColors.Light.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">@color/mp_nav_bar_legacy</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MPManager.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MPManager.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MPManager.Large</item>
    </style>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.Material3">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="tint">?attr/colorOnSurface</item>
    </style>
    <style name="text_action_popup_animation">
        <item name="android:windowEnterAnimation">@anim/anim_text_action_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/anim_text_action_popup_exit</item>
    </style>
    <style name="TabTextAppearance" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">normal</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="ToolbarSmallSubtitle" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="textSize">10sp</item>
    </style>
    <style name="inspectorDialogTheme" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="alertDialogTheme">@style/AppCompat.Dialog</item>
    </style>

    <!-- Invisible one-shot activity that writes the clipboard then finishes
         (ClipboardActivity). Translucent so no blank flash while it runs. -->
    <style name="ClipboardCopyTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="AppCompat.Dialog" parent="@style/ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowTitleStyle">@style/RtlOverlay.DialogWindowTitle.AppCompat</item>
        <item name="buttonBarButtonStyle">@style/Widget.Material3.Button.TextButton.Dialog.Flush</item>
    </style>

    <style name="HexCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Literal colors on purpose: theme attrs (?attr/colorSurfaceVariant etc.) rendered
         invisibly for some users, so the keys get a fixed medium-gray fill + white text
         which contrasts against both light and dark surfaces -->
    <style name="HexKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textSize">18sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="ThemeOverlay.Accent.Purple" parent="android:ThemeOverlay">
        <item name="colorPrimary">#FF6750A4</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FF6750A4</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSecondary">#FF6750A4</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FF6750A4</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorAccent">#FF6750A4</item>
        <item name="android:colorAccent">#FF6750A4</item>
    </style>
