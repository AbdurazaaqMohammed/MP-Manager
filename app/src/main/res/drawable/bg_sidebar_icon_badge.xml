<?xml version="1.0" encoding="utf-8"?>
<!--
  Round badge behind a drawer row's icon.

  The sidebar tints each icon to the accent colour per bind, which reads fine on a bare icon but
  disappears into a card. Filling the badge with a neutral dark tone and leaving the icon light
  gives every row the same visual anchor, the way MT Manager's drawer does.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#424242" />
</shape>