<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawer header bar.

  MT Manager's drawer is the reference: a dark, square-cornered bar with white type, so the
  navigation list below it reads as the only light surface. The tone is fixed instead of themed
  because a header that follows the surface colour disappears into the list on light themes and
  turns into a black bar on dark ones.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2E2E2E" />
</shape>
