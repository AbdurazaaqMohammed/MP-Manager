<?xml version="1.0" encoding="utf-8"?>
<!--
  Toolbar menu for dex translation mode. Apply sits on the bar and run engine does not, so this
  keeps only what the bottom bar cannot carry: the source language, settings, and revert.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/xlate_menu_apply"
        android:icon="@drawable/baseline_check_circle_24"
        android:title="@string/xlate_apply"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/xlate_menu_source_language"
        android:title="@string/xlate_source_language"
        app:showAsAction="never" />

    <item
        android:id="@+id/xlate_menu_settings"
        android:title="@string/xlate_settings"
        app:showAsAction="never" />

    <item
        android:id="@+id/xlate_menu_revert"
        android:title="@string/xlate_revert"
        app:showAsAction="never" />

</menu>