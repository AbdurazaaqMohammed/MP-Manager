<?xml version="1.0" encoding="utf-8"?>
<!--
  Column headings for the string grid.

  The two headings line up with the columns of item_translate_row because both use the same
  padding and the same divider insets. Keep them in step: changing one without the other makes
  the headings point at the wrong column.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceVariant"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="8dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/xlate_column_original"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/xlate_column_original"
android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- A fixed height, not match_parent: this row wraps its content, so a match_parent
         divider has no resolved height to fill and would collapse to nothing. -->
    <View
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="?android:attr/listDivider" />

    <TextView
        android:id="@+id/xlate_column_translation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/xlate_column_translation"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>