<?xml version="1.0" encoding="utf-8"?>
<!--
  MT-style translation mode.

  Page 1 lists every language series the APK was built from - that is what you pick first.
  Page 2 edits the entries of the one you picked. Both live in a single activity because they
  share one loaded resource table, and re-parsing it on every switch would be wasteful.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/xlate_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="@string/translation_mode" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/xlate_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:trackCornerRadius="2dp" />

    <!-- Page 1: the language series -->
    <LinearLayout
        android:id="@+id/xlate_languages_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/xlate_languages_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp"
            android:text="@string/xlate_languages_hint"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:hint="@string/xlate_search_languages"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/search_24px">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/xlate_languages_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/xlate_languages_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/xlate_add_config"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/xlate_add_config" />
    </LinearLayout>

    <!-- Page 2: the entries of the picked language -->
    <LinearLayout
        android:id="@+id/xlate_entries_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/xlate_config_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/xlate_path_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <TextView
                android:id="@+id/xlate_config_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/xlate_engine_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:hint="@string/xlate_search_strings"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/search_24px">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/xlate_strings_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/xlate_strings_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <!-- Bottom action bar, matching MT Manager: select-all, edit, multi-select, run engine,
             filter. Run engine and filter moved down from the toolbar for this; the rest of the
             toolbar menu is unchanged and still reachable from the overflow button. -->
        <LinearLayout
            android:id="@+id/xlate_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceVariant"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/xlate_bar_select_all"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/xlate_select_all"
                android:src="@drawable/baseline_select_all_24" />

            <ImageButton
                android:id="@+id/xlate_bar_edit"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/xlate_menu_edit"
                android:src="@drawable/edit_24px" />

            <!-- Multi-select toggle. Shows an X while the mode is off because the row
                 checkboxes it turns on are what it dismisses again. -->
            <ImageButton
                android:id="@+id/xlate_bar_multi"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/xlate_multi_select"
                android:src="@drawable/close_24px" />

            <ImageButton
                android:id="@+id/xlate_bar_translate"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/xlate_run"
                android:src="@drawable/ic_translate_mt" />

            <ImageButton
                android:id="@+id/xlate_bar_filter"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/xlate_search_strings"
                android:src="@drawable/baseline_filter_list_24" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
