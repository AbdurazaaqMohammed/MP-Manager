<?xml version="1.0" encoding="utf-8"?>
<!--
  One translatable string resource: a single line of the APK's own text.

  No heading, no inline field. Tapping the row opens the editor dialog, which is how MT Manager
  does it too, and it matters at this scale - a config can hold tens of thousands of entries,
  and a RecyclerView row per entry cannot carry a live EditText without the list eating memory
  as it scrolls.

  The checkbox only appears in multi-select mode, which is why it starts gone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/xlate_row_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/xlate_row_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

</LinearLayout>