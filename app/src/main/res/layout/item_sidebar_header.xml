<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/sidebarSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/sidebarSectionDragHandle"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:contentDescription="@string/drag_to_reorder"
        android:padding="8dp"
        android:visibility="invisible"
        android:src="@drawable/drag_handle_24px"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageView
        android:id="@+id/sidebarSectionToggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/sidebar_collapse"
        android:src="@drawable/arrow_drop_down_24px"
        app:tint="?attr/colorOnSurface" />
</LinearLayout>
