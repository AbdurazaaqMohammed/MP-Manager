<?xml version="1.0" encoding="utf-8"?>
<!--
  Section heading inside the drawer.

  MT Manager's drawer is one continuous white sheet: rows touch each other and the headings sit
  on the same white, grey type alone marking the break. No band, no margin - a tinted strip here
  is what made the list read as a stack of separate cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Grey and large rather than accent-coloured and small: the section is a heading, and the
         rows below it carry the accent. Colouring both makes the drawer read as one flat list. -->
    <TextView
        android:id="@+id/sidebarSectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/sidebarSectionDragHandle"
        android:layout_width="32dp"
        android:layout_height="40dp"
        android:contentDescription="@string/drag_to_reorder"
        android:padding="8dp"
        android:visibility="invisible"
        android:src="@drawable/drag_handle_24px"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageView
        android:id="@+id/sidebarSectionToggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/sidebar_collapse"
        android:src="@drawable/arrow_drop_up_24px"
        app:tint="?attr/colorOnSurface" />
</LinearLayout>
