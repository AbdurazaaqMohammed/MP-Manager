<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/unified_row_old"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/unified_num_old"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingEnd="6dp"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/unified_marker_old"
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unified_text_old"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:paddingStart="2dp"
            android:paddingEnd="8dp"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/unified_row_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/unified_num_new"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingEnd="6dp"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary" />

        <TextView
            android:id="@+id/unified_marker_new"
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/unified_text_new"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:paddingStart="2dp"
            android:paddingEnd="8dp"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorPrimary" />
    </LinearLayout>

</LinearLayout>
