<?xml version="1.0" encoding="utf-8"?>
<!--
  One extracted literal: the layout's own text on the left, the staged translation on the right,
  split by a hairline. Nothing is editable in place - a tap opens the editor dialog, which is how
  MT does it and what a list this long needs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/xml_row_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="5"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:id="@+id/xml_row_translation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/colorSurfaceContainer"
        android:maxLines="5"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />

</LinearLayout>
