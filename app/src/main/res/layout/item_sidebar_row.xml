<?xml version="1.0" encoding="utf-8"?>
<!--
  Drawer row: round icon badge, label with optional path underneath, and the organise-mode
  affordances.

  A copy of item_dropdown_option.xml on purpose. That layout is shared with DropdownAdapter and
  ExtractOptionAdapter, which are compact single-line pickers with no badge; giving them a 40dp
  circle and a second line would change three screens to restyle one.

  View ids match the shared layout so SidebarAdapter's findViewById calls keep working.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sidebar_row"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="6dp"
    android:paddingEnd="20dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/optionIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_sidebar_icon_badge"
        android:contentDescription="@string/option_icon_cd"
        android:padding="10dp"
        app:tint="#FFFFFF" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/optionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/optionSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/optionHideButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/hide"
        android:padding="10dp"
        android:visibility="invisible"
        android:src="@drawable/visibility_off_24px"
        app:tint="?attr/colorOnSurfaceVariant" />

    <ImageView
        android:id="@+id/optionDragHandle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/drag_to_reorder"
        android:padding="10dp"
        android:visibility="invisible"
        android:src="@drawable/drag_handle_24px"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
