<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

        <!-- Headings for the two table columns. Placed inside the same header view rather than
             outside the list, because this tab builds its header as a ConcatAdapter item and has
             no pinned slot to put one in. -->
        <include
            layout="@layout/view_dex_columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/btn_strings_reload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackground"
            android:text="@string/reload"
            android:textSize="13sp"
            android:padding="10dp"
            app:drawableStartCompat="@drawable/baseline_refresh_24" />

        <TextView
            android:id="@+id/btn_strings_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackground"
            app:drawableStartCompat="@drawable/baseline_filter_list_24"
            android:text="@string/filter"
            android:padding="10dp"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_strings_replace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackground"
            android:text="@string/replace"
            app:drawableStartCompat="@drawable/find_replace_24px"
            android:padding="10dp"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/btn_strings_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurface"
            android:background="?attr/selectableItemBackground"
            android:text="@string/apply_changes"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="10dp"
            app:drawableStartCompat="@drawable/baseline_check_circle_24"
            android:visibility="gone" />

</LinearLayout>