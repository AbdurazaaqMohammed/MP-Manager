        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.appops.AppOpsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection"
            android:exported="false">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.appops.AppOpsDetailActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection"
            android:exported="false">
        </activity>
        <service
            android:name="io.github.abdurazaaqmohammed.tools.PrivateDnsTileService"
            android:icon="@drawable/wifi_24px"
            android:label="Private DNS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name="io.github.abdurazaaqmohammed.tools.CacheCleanerService"
            android:label="MP Manager Cache Cleaner"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/cache_cleaner_service" />
        </service>
       <activity
           android:name="io.github.abdurazaaqmohammed.ui.activities.TextEditorActivity"
           android:windowSoftInputMode="adjustResize|stateHidden"
           android:launchMode="singleTop"
           android:exported="false">
       </activity>
        <activity
            android:name="io.github.abdurazaaqmohammed.features.files.MainSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="io.github.abdurazaaqmohammed.ui.activities.EditorSettingsActivity"
            android:exported="false">
        </activity>
        <activity
            android:name="io.github.abdurazaaqmohammed.ui.activities.HexEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="io.github.abdurazaaqmohammed.ui.activities.HtmlViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection" />
        <activity
            android:name="io.github.abdurazaaqmohammed.arsc.ArscEditorPlusActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="io.github.abdurazaaqmohammed.arsc.ArscEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="io.github.abdurazaaqmohammed.arsc.ArscTextActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="io.github.abdurazaaqmohammed.ui.activities.CompareTextActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name="io.github.abdurazaaqmohammed.ui.activities.CompareDexActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|keyboardHidden" />
           <activity
               android:name="modder.hub.dexeditor.activity.SettingsActivity"
               android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
               android:hardwareAccelerated="true"
               android:supportsPictureInPicture="true" />
           <activity
               android:name="modder.hub.dexeditor.activity.EditFloatingMenusActivity"
               android:configChanges="orientation|screenSize" />
            <activity
                android:name="modder.hub.dexeditor.activity.AIOverViewActivity"
                android:configChanges="orientation|screenSize" />
            <provider
                android:name="rikka.shizuku.ShizukuProvider"
                android:authorities="${applicationId}.shizuku"
                android:multiprocess="false"
                android:enabled="true"
                android:exported="true"
                android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
            <provider
                android:name="androidx.startup.InitializationProvider"
               android:authorities="${applicationId}.androidx-startup"
               android:exported="false"
               tools:ignore="MissingClass"
               tools:node="merge">
               <meta-data
                   android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                   android:value="androidx.startup" />
               <!-- Cold-start: emoji2's initializer wires up EmojiCompat and pulls the
                    system emoji font on every process start. Text renders with the
                    platform's emoji instead, so the initializer is dropped from the
                    merged manifest (its node also comes from the emoji2 library). -->
               <meta-data
                   android:name="androidx.emoji2.text.EmojiCompatInitializer"
                   tools:node="remove" />
           </provider>
            <activity
                android:name="modder.hub.dexeditor.activity.DexEditorActivity"
                android:configChanges="orientation|screenSize|keyboardHidden"
                android:windowSoftInputMode="adjustResize" />
           <provider
               android:name="androidx.core.content.FileProvider"
               android:authorities="${applicationId}.provider"
               android:exported="false"
               android:grantUriPermissions="true">
               <meta-data
                   android:name="android.support.FILE_PROVIDER_PATHS"
                   android:resource="@xml/paths"/>
           </provider>
           <!-- Storage Access Framework entry: the system Files app lists this
                provider in its sidebar, and any app's document picker can use
                it to choose a file from MP Manager. MANAGE_DOCUMENTS keeps it
                bound to the system document UI only. -->
           <provider
               android:name="io.github.abdurazaaqmohammed.provider.StorageDocumentsProvider"
               android:authorities="${applicationId}.documents"
               android:exported="true"
               android:grantUriPermissions="true"
               android:permission="android.permission.MANAGE_DOCUMENTS">
               <intent-filter>
                   <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
               </intent-filter>
           </provider>
           <service android:name="com.faith.apkinstaller.APKInstallService" />
           <service
                android:name=".ftp.FtpForegroundService"
                android:foregroundServiceType="specialUse"
                android:exported="false" />
            <service
                android:name="io.github.abdurazaaqmohammed.mcp.McpServerService"
                android:foregroundServiceType="specialUse"
                android:exported="false">
                <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="MCP server" />
            </service>
           <service
               android:name="io.github.codehasan.colorpicker.services.ColorPickerService"
               android:enabled="true"
               android:exported="false"
               android:foregroundServiceType="mediaProjection" />
            <receiver android:name="io.github.abdurazaaqmohammed.mcp.McpStopReceiver" android:exported="false" />
            <receiver android:name=".ftp.StopReceiver" android:exported="false" />
            <receiver android:name=".ftp.CopyReceiver" android:exported="false" />
            <!-- Pause / cancel tapped in the progress notification. -->
            <receiver
                android:name="io.github.abdurazaaqmohammed.utils.ProgressActionReceiver"
                android:exported="false" />
            <service
                android:name="io.github.abdurazaaqmohammed.tools.ScreenCaptureService"
                android:enabled="true"
                android:exported="false"
                android:foregroundServiceType="mediaProjection" />
            <receiver
                android:name="io.github.abdurazaaqmohammed.plugins.ipc.PluginPackageReceiver"
                android:exported="false">
                <intent-filter>
                    <action android:name="android.intent.action.PACKAGE_ADDED" />
                    <action android:name="android.intent.action.PACKAGE_REPLACED" />
                    <action android:name="android.intent.action.PACKAGE_REMOVED" />
                    <data android:scheme="package" />
                </intent-filter>
            </receiver>
             <activity
                 android:name="io.github.abdurazaaqmohammed.player.ImageViewerActivity"
                 android:configChanges="orientation|screenSize|keyboardHidden"
                 android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
             <activity
                 android:name="io.github.abdurazaaqmohammed.player.ImageEditActivity"
                 android:exported="false"
                 android:label="@string/image_editor"
                 android:configChanges="orientation|screenSize|keyboardHidden"
                 android:windowSoftInputMode="adjustResize|stateHidden"
                 android:theme="@style/Theme.Material3.DayNight.NoActionBar">
             </activity>
              <activity
                  android:name="io.github.abdurazaaqmohammed.player.SharedEntryActivity"
                  android:exported="true"
                  android:excludeFromRecents="true"
                  android:noHistory="true"
                  android:label="@string/shared_entry_title"
                  android:configChanges="orientation|screenSize|keyboardHidden"
                  android:theme="@style/Theme.Material3.DayNight.NoActionBar">
                  <intent-filter>
                      <action android:name="android.intent.action.SEND" />
                      <action android:name="android.intent.action.SEND_MULTIPLE" />
                      <action android:name="android.intent.action.VIEW" />
                      <action android:name="android.intent.action.EDIT" />
                      <category android:name="android.intent.category.DEFAULT" />
                      <data android:mimeType="*/*" />
                  </intent-filter>
              </activity>
            <activity
                android:name="io.github.abdurazaaqmohammed.player.MediaPlayerActivity"
                android:configChanges="orientation|screenSize|keyboardHidden"
                android:theme="@style/Theme.Material3.DayNight.NoActionBar" />
            <activity
                android:name="io.github.ratul.topactivity.ui.ClipboardActivity"
                android:exported="false"
                android:noHistory="true"
                android:excludeFromRecents="true"
                android:theme="@style/ClipboardCopyTheme" />
            <service
                android:name="io.github.abdurazaaqmohammed.player.MusicService"
                android:foregroundServiceType="mediaPlayback"
                android:exported="false" />
            <service
                android:name="io.github.ratul.topactivity.services.PackageMonitoringService"
                android:exported="false" />
            <service
                android:name="io.github.ratul.topactivity.services.AccessibilityMonitoringService"
               android:description="@string/accessibility_service_description"
               android:exported="true"
               android:label="@string/app_name"
               android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
               <intent-filter>
                   <action android:name="android.accessibilityservice.AccessibilityService" />
