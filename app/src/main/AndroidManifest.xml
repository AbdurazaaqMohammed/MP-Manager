        </activity>
        <service
            android:name="io.github.abdurazaaqmohammed.tools.LogcatService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />
        <activity
            android:name="modder.hub.dexeditor.activity.TranslationModeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="io.github.abdurazaaqmohammed.freestyle.FreeStylePickerActivity"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:label="@string/free_style"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection" />
        <activity
            android:name="io.github.abdurazaaqmohammed.freestyle.FreeStyleCanvasActivity"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:label="@string/free_style"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection" />
        <!-- Picker entry point: apps that ask the system for a file can choose
             MP Manager and browse with the app's own FilePickerDialog. -->
        <activity
            android:name="io.github.abdurazaaqmohammed.ui.activities.PickFileActivity"
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:label="MP Manager"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.DocumentsBrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection"
            android:exported="false">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
