<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="preferExternal"
    package="io.github.abdurazaaqmohammed.MPManager">
    <uses-sdk tools:overrideLibrary="io.github.rosemoe.sora.langs.java, androidx.window, androidx.window.core, rikka.shizuku.provider, rikka.shizuku.api, rikka.shizuku.shared, rikka.shizuku.aidl" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.MANAGE_DEVICE_POLICY_ACCESSIBILITY" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" android:minSdkVersion="30"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CLEAR_APP_CACHE"
        tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-permission-sdk-23 android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- External plugin discovery (out-of-process plugins expose these actions). -->
    <queries>
        <intent>
            <action android:name="io.github.abdurazaaqmohammed.MPManager.action.SIDEBAR_OPEN" />
        </intent>
        <intent>
            <action android:name="io.github.abdurazaaqmohammed.MPManager.action.SETTING_CONFIG" />
        </intent>
        <intent>
            <action android:name="io.github.abdurazaaqmohammed.MPManager.action.FILE_MENU" />
        </intent>
        <intent>
            <action android:name="io.github.abdurazaaqmohammed.MPManager.action.EDITOR_ACTION" />
        </intent>
        <intent>
            <action android:name="io.github.abdurazaaqmohammed.MPManager.action.APK_ACTION" />
        </intent>
    </queries>

        <application
            android:fullBackupContent="@xml/network_backup_rules"
            android:dataExtractionRules="@xml/network_data_extraction_rules"
            android:usesCleartextTraffic="true"
            android:localeConfig="@xml/locales_config"
            android:requestLegacyExternalStorage="true"
           android:enableOnBackInvokedCallback="false"
           android:largeHeap="true"
           android:theme="@style/Theme.Material3.DayNight.NoActionBar"
           android:name="io.github.ratul.topactivity.App"
           android:icon="@mipmap/ic_launcher"
           android:label="MP Manager">
        <activity
            android:theme="@style/Theme.MPManager.Splash"
            android:name="io.github.abdurazaaqmohammed.MPManager.MainActivity"
            android:launchMode="singleTop"
            android:alwaysRetainTaskState="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
           <activity
               android:theme="@style/Theme.Material3.DayNight.NoActionBar"
               android:name="io.github.abdurazaaqmohammed.ApkExtractor.APKExtractorActivity"
            android:exported="false">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.features.sqlite.SqliteViewerActivity"
            android:exported="false"
            android:label="SQLite Viewer">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.ToolsHubActivity"
            android:exported="false"
            android:label="Plugins">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.ToolRunnerActivity"
            android:exported="false">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.WifiManagerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.abdurazaaqmohammed.MPManager.APPLY_DNS_PROFILE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.StorageManagerActivity"
            android:exported="false">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.tools.AdbBrowserActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
            android:name="io.github.abdurazaaqmohammed.mcp.McpServerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|layoutDirection"
            android:exported="false">
        </activity>
        <activity
            android:theme="@style/Theme.Material3.DayNight.NoActionBar"
