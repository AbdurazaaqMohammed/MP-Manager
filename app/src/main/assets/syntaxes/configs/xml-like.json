{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<!--", "-->"],
    ["<", ">"],
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*<(?![?!]|/|(?:area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)\\b)[^>]+(?<!/)>\\s*$",
    "decreaseIndentPattern": "^\\s*</[^>]+>\\s*$"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*<!--\\s*#region\\b",
      "end": "^\\s*<!--\\s*#endregion\\b"
    }
  }
}
