{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"], {
      "open": "\"",
      "close": "\"",
      "notIn": ["string"]
    }, {
      "open": "'",
      "close": "'",
      "notIn": ["string"]
    }, {
      "open": "/**",
      "close": " */",
      "notIn": ["string"]
    }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "comments": {
    "lineComment": "#"
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:\\.method\\b.*|\\.param\\b.*|\\.annotation\\b.*|\\.subannotation\\b.*|\\.packed-switch\\b.*|\\.sparse-switch\\b.*|\\.array-data\\b.*|:try_start_\\S*|.*\\{\\s*)$",
    "decreaseIndentPattern": "^\\s*(?:\\.end\\s+(?:method|field|annotation|subannotation|param|packed-switch|sparse-switch|array-data)\\b|:try_end_\\S*|\\})"
  },
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}